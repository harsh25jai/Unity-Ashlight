<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud-root" style="flex-grow: 1; position: relative;">
        <ui:Label name="night-phase-label"
                  text="DAY"
                  style="position: absolute; top: 20px; align-self: center; left: 50%; translate: -50% 0; font-size: 20px; -unity-font-style: bold; color: rgb(122, 184, 122);" />

        <ui:Label name="night-counter-label"
                  text="Night 0"
                  style="position: absolute; top: 20px; right: 20px; font-size: 16px; color: rgb(158, 158, 158); -unity-text-align: middle-right;" />

        <ui:Label name="fear-indicator"
                  text="&#9672;"
                  style="position: absolute; bottom: 80px; right: 20px; font-size: 24px; color: rgb(192, 48, 48); opacity: 0;" />

        <ui:VisualElement name="damage-flash"
                          style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(192, 48, 48, 0); pointer-events: none;" />

        <ui:VisualElement name="game-over-panel"
                          style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; display: none;">
            <ui:Label text="YOU PERISHED"
                      style="font-size: 48px; color: rgb(192, 48, 48); -unity-font-style: bold; margin-bottom: 32px;" />
            <ui:Button name="return-church-button" text="Return to Church"
                       style="width: 280px; height: 48px; margin-bottom: 12px; font-size: 18px; background-color: rgb(42, 31, 10); color: rgb(201, 149, 42); border-color: rgb(201, 149, 42); border-width: 1px;" />
            <ui:Button name="main-menu-button" text="Main Menu"
                       style="width: 280px; height: 48px; font-size: 18px; background-color: rgb(26, 26, 26); color: rgb(200, 200, 200); border-color: rgb(100, 100, 100); border-width: 1px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
