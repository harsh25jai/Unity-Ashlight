.menu-root {
    flex-grow: 1;
    position: relative;
    justify-content: center;
    align-items: center;
    background-color: rgb(8, 10, 16);
}

.background-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(13, 18, 32);
}

.vignette-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
}

.ambient-glow {
    position: absolute;
    width: 55%;
    height: 45%;
    align-self: center;
    background-color: rgba(201, 149, 42, 0.06);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.center-panel {
    align-items: center;
    justify-content: center;
    padding: 32px;
    opacity: 0;
}

.title-block {
    align-items: center;
    margin-bottom: 48px;
}

.title-label {
    font-size: 72px;
    color: rgb(201, 149, 42);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 12px;
    text-shadow: 0 0 18px rgba(201, 149, 42, 0.35);
}

.title-underline {
    width: 120px;
    height: 2px;
    background-color: rgb(201, 149, 42);
    margin-bottom: 20px;
    opacity: 0.7;
}

.tagline-label {
    font-size: 18px;
    color: rgb(122, 158, 124);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    opacity: 0.9;
}

.button-stack {
    align-items: center;
    min-width: 240px;
}

.menu-button {
    width: 100%;
    min-width: 220px;
    max-width: 280px;
    height: 48px;
    margin-top: 6px;
    margin-bottom: 6px;
    font-size: 17px;
    background-color: rgb(26, 46, 26);
    color: rgb(201, 149, 42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(201, 149, 42);
    border-bottom-color: rgb(201, 149, 42);
    border-left-color: rgb(201, 149, 42);
    border-right-color: rgb(201, 149, 42);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    -unity-font-style: bold;
    transition-property: scale, background-color, border-color, color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    background-color: rgb(42, 62, 42);
    scale: 1.05 1.05;
    border-top-color: rgb(232, 192, 96);
    border-bottom-color: rgb(232, 192, 96);
    border-left-color: rgb(232, 192, 96);
    border-right-color: rgb(232, 192, 96);
}

.menu-button:active {
    scale: 0.98 0.98;
    background-color: rgb(34, 52, 34);
}

.menu-button:focus {
    border-top-color: rgb(255, 220, 140);
    border-bottom-color: rgb(255, 220, 140);
    border-left-color: rgb(255, 220, 140);
    border-right-color: rgb(255, 220, 140);
}

.menu-button:disabled {
    background-color: rgb(18, 28, 18);
    color: rgb(85, 85, 85);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    scale: 1 1;
}

.menu-button-secondary {
    background-color: rgb(20, 28, 22);
}

.menu-button-quit {
    margin-top: 12px;
    background-color: rgb(28, 18, 18);
    border-top-color: rgb(120, 60, 60);
    border-bottom-color: rgb(120, 60, 60);
    border-left-color: rgb(120, 60, 60);
    border-right-color: rgb(120, 60, 60);
    color: rgb(200, 140, 140);
}

.menu-button-quit:hover {
    background-color: rgb(48, 28, 28);
    border-top-color: rgb(160, 80, 80);
    border-bottom-color: rgb(160, 80, 80);
    border-left-color: rgb(160, 80, 80);
    border-right-color: rgb(160, 80, 80);
    color: rgb(230, 170, 170);
}

.no-save-label {
    font-size: 13px;
    color: rgb(140, 120, 100);
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-bottom: 2px;
    display: none;
}

.no-save-label--visible {
    display: flex;
}

.status-label {
    font-size: 13px;
    color: rgb(140, 120, 100);
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-bottom: 2px;
    display: none;
}

.status-label--visible {
    display: flex;
}

.footer-credit {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    font-size: 12px;
    color: rgb(68, 68, 68);
    -unity-text-align: middle-center;
    opacity: 0.8;
}
