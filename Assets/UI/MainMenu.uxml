<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MainMenu.uss" />

    <ui:VisualElement name="menu-root" class="menu-root">
        <ui:VisualElement name="background-layer" class="background-layer" />
        <ui:VisualElement name="vignette-overlay" class="vignette-overlay" />
        <ui:VisualElement name="ambient-glow" class="ambient-glow" />

        <ui:VisualElement name="center-panel" class="center-panel">
            <ui:VisualElement class="title-block">
                <ui:Label name="title-label" text="ASHLIGHT" class="title-label" />
                <ui:VisualElement class="title-underline" />
                <ui:Label name="tagline-label"
                          text="Carry the light. Survive the night."
                          class="tagline-label" />
            </ui:VisualElement>

            <ui:VisualElement name="button-stack" class="button-stack">
                <ui:Button name="new-game-button" text="NEW GAME" class="menu-button" focusable="true" />
                <ui:Button name="continue-button" text="CONTINUE" class="menu-button menu-button-secondary" focusable="true" />
                <ui:Label name="no-save-label" text="No save found" class="no-save-label" />
                <ui:Button name="settings-button" text="SETTINGS" class="menu-button menu-button-secondary" focusable="true" />
                <ui:Button name="quit-button" text="QUIT" class="menu-button menu-button-quit" focusable="true" />
            </ui:VisualElement>

            <ui:Label name="status-label" text="" class="status-label" />
        </ui:VisualElement>

        <ui:Label text="A game about faith and darkness" class="footer-credit" />
    </ui:VisualElement>
</ui:UXML>
